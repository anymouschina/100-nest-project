      "parameters": {
        "jsCode": "// 示例文本数据
const documents = [
  { text: "人工智能正在改变我们生活的各个方面", category: "技术" },
  { text: "机器学习是AI的一个子集，专注于算法学习", category: "技术" },
  { text: "深度学习使用神经网络模拟人脑工作", category: "技术" },
  { text: "健康饮食和定期锻炼是长寿的关键", category: "健康" },
  { text: "中国经济持续增长，成为全球第二大经济体", category: "经济" }
];

return documents.map((doc, index) => ({
  json: {
    id: index + 1,
    content: doc.text,
    category: doc.category
  }
}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0],
      "id": "prepare-data",
      "name": "准备示例数据"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- 设置pgvector环境
CREATE EXTENSION IF NOT EXISTS vector;

CREATE TABLE IF NOT EXISTS document_vectors (
    id SERIAL PRIMARY KEY,
    content TEXT NOT NULL,
    category VARCHAR(50),
    embedding VECTOR(1536),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 创建索引
CREATE INDEX IF NOT EXISTS document_vectors_embedding_idx 
ON document_vectors USING ivfflat (embedding vector_cosine_ops);

-- 清空旧数据
TRUNCATE TABLE document_vectors;"
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [480, 0],
      "id": "setup-pgvector",
      "name": "初始化PGVector",
      "credentials": {
        "postgres": {
          "host": "localhost",
          "port": 5432,
          "database": "n8n",
          "user": "postgres",
          "password": "postgres",
          "schema": "public"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 使用内置向量生成器创建模拟向量
const content = $json.content;
const category = $json.category;

// 创建1536维的模拟向量（实际使用OpenAI API）
const createMockVector = (text) => {
  const vector = [];
  const hash = text.split('').reduce((a, b) => {
    a = ((a << 5) - a) + b.charCodeAt(0);
    return a & a;
  }, 0);
  
  for (let i = 0; i < 1536; i++) {
    vector.push(((hash + i) % 2000 - 1000) / 1000);
  }
  return vector;
};

const embedding = createMockVector(content);

return {
  ...$json,
  embedding: JSON.stringify(embedding)
};"
      },
