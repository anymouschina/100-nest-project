    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- 统计数据
SELECT 
  COUNT(*) as total_documents,
  COUNT(DISTINCT category) as categories,
  MIN(created_at) as first_document,
  MAX(created_at) as latest_document
FROM document_vectors;"
