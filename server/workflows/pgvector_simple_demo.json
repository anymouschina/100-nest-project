    },
    {
      "parameters": {
        "jsCode": "// 生成查询向量
const query = $json.search_query;

// 创建与存储向量相同格式的查询向量
const createQueryVector = (text) => {
  const vector = [];
  const hash = text.split('').reduce((a, b) => {
    a = ((a << 5) - a) + b.charCodeAt(0);
    return a & a;
  }, 0);
  
  for (let i = 0; i < 1536; i++) {
    vector.push(((hash + i) % 2000 - 1000) / 1000);
  }
  return vector;
};

const query_embedding = createQueryVector(query);

return {
  ...$json,
  query_embedding: JSON.stringify(query_embedding)
};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 220],
      "id": "create-query-vector",
      "name": "创建查询向量"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- 向量相似度搜索
SELECT 
  id,
  content,
  category,
  created_at,
  (embedding <=> '{{$json.query_embedding}}'::vector) as similarity_score
FROM document_vectors
ORDER BY similarity_score ASC
LIMIT 5;"
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [720, 220],
      "id": "vector-search",
      "name": "向量相似度搜索",
      "credentials": {
        "postgres": {
          "host": "localhost",
          "port": 5432,
          "database": "n8n",
          "user": "postgres",
          "password": "postgres",
          "schema": "public"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 格式化搜索结果
const results = $json;
const searchQuery = results[0]?.search_query || '未知查询';

let report = `🔍 PGVector 向量搜索结果\n`;
report += `===============================\n\n`;
report += `搜索查询: "${searchQuery}"\n\n`;
report += `📊 找到 ${results.length} 个相关结果:\n\n`;

results.forEach((result, index) => {
  report += `${index + 1}. ${result.content}\n`;
  report += `   📂 分类: ${result.category}\n`;
  report += `   🔗 相似度: ${Math.abs(result.similarity_score).toFixed(3)}\n`;
  report += `   🆔 ID: ${result.id}\n\n`;
});

return {
  search_summary: report,
  result_count: results.length
};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 220],
      "id": "format-results",
      "name": "格式化搜索结果"
