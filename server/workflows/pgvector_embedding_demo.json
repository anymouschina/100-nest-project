    {
      "parameters": {
        "jsCode": "// 生成搜索查询的向量
const query = $json.search_query;
const apiKey = 'YOUR_OPENAI_API_KEY'; // 请替换为实际API密钥

const response = await fetch('https://api.openai.com/v1/embeddings', {
  method: 'POST',
  headers: {
    'Content-Type': 'application/json',
    'Authorization': `Bearer ${apiKey}`
  },
  body: JSON.stringify({
    input: query,
    model: 'text-embedding-ada-002'
  })
});

const result = await response.json();
const queryEmbedding = result.data[0].embedding;

return {
  ...$json,
  query_embedding: JSON.stringify(queryEmbedding)
};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 220],
      "id": "generate-query-vector",
      "name": "生成查询向量"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- 相似度搜索
SELECT 
  id,
  content,
  category,
  created_at,
  1 - (embedding <=> '{{$json.query_embedding}}'::vector) as similarity
FROM document_vectors
WHERE 1 - (embedding <=> '{{$json.query_embedding}}'::vector) > 0.7
ORDER BY similarity DESC
LIMIT 5;"
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [720, 220],
      "id": "vector-search",
      "name": "向量相似度搜索",
      "credentials": {
        "postgres": {
          "host": "localhost",
          "database": "n8n",
          "user": "postgres",
          "password": "postgres",
          "port": 5432
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 格式化搜索结果
const results = $json;

let output = `🔍 向量搜索查询: "${results[0]?.search_query || '未知'}"\n\n`;
output += `📊 找到 ${results.length} 个相关结果:\n\n`;

results.forEach((result, index) => {
  output += `${index + 1}. **${result.content}**\n`;
  output += `   📂 分类: ${result.category}\n`;
  output += `   🔗 相似度: ${(result.similarity * 100).toFixed(1)}%\n`;
  output += `   🕐 创建时间: ${result.created_at}\n\n`;
});

return {
  search_summary: output
};"
