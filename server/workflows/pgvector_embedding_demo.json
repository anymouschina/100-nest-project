      "parameters": {
        "jsCode": "// 示例文本数据
const documents = [
  { text: "人工智能正在改变我们生活的各个方面", category: "技术" },
  { text: "机器学习是AI的一个子集，专注于算法学习", category: "技术" },
  { text: "深度学习使用神经网络模拟人脑工作", category: "技术" },
  { text: "自然语言处理让计算机理解人类语言", category: "技术" },
  { text: "计算机视觉使机器能够看见和理解图像", category: "技术" },
  { text: "健康饮食和定期锻炼是长寿的关键", category: "健康" },
  { text: "心理健康与身体健康同等重要", category: "健康" },
  { text: "充足的睡眠对认知功能至关重要", category: "健康" },
  { text": "中国经济持续增长，成为全球第二大经济体", category: "经济" },
  { text: "数字化转型正在重塑传统商业模式", category: "商业" }
];

return documents.map((doc, index) => ({
  json: {
    id: index + 1,
    content: doc.text,
    category: doc.category
  }
}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0],
      "id": "prepare-data",
      "name": "准备示例数据"
