    "@langchain/openai": "^0.3.12",
    "@langchain/pinecone": "^0.1.1",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "10.4.18",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^7.3.1",
    "@prisma/client": "^5.15.1",
    "@types/bcrypt": "^5.0.2",
    "@types/pg": "^8.15.4",
    "@types/uuid": "^10.0.0",
    "axios": "^1.9.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "ioredis": "^5.6.1",
    "joi": "^17.13.3",
    "langchain": "^0.3.28",
    "ollama": "^0.5.16",
    "openai": "^4.67.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.0",
    "pgvector": "^0.2.0",
    "prisma": "^5.15.1",
    "readline": "^1.3.0",
    "redis": "^5.5.5",
