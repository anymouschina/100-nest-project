generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// 启用pgvector扩展
generator pgvector {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model User {
  userId          Int               @id @default(autoincrement())
  name            String
  email           String?           @unique
  password        String?
  address         String?
  phone           String?           // 添加手机号字段
  createdAt       DateTime          @default(now())
  openId          String?           @unique
  unionId         String?           @unique
  avatarUrl       String?
  gender          Int?
  country         String?
  province        String?
  city            String?
  language        String?
  ref             String?           // 引荐码，用于记录用户是被谁引荐的
  appointments    Appointment[]
  cart            Cart?
  CoupunOrderUser CoupunOrderUser[]
  orders          Order[]
  referredUsers   UserReferral[]    @relation("ReferredUsers")
  referredBy      UserReferral?     @relation("ReferredBy")
  chatSessions    ChatSession[]     // 关联的聊天会话
}

// 用户引荐关联记录表
model UserReferral {
  id                Int           @id @default(autoincrement())
  userId            Int           @unique // 被引荐的用户ID
  refCode           String        // 引荐码
  referrerOpenId    String?       // 引荐人的OpenID，设为可选
  createdAt         DateTime      @default(now())
  source            String?       // 引荐来源
  metadata          Json?         // 额外元数据
  user              User          @relation("ReferredBy", fields: [userId], references: [userId])
  referrer          User?         @relation("ReferredUsers", fields: [referrerOpenId], references: [openId])
  referralCodeId    Int?          // 关联的引荐码ID，可为空（兼容老数据）
  referralCode      ReferralCode? @relation(fields: [referralCodeId], references: [id])
}

model Order {
  orderId         Int               @id @default(autoincrement())
  total           Float
  status          Status            @default(PENDING)
  createdAt       DateTime          @default(now())
  userId          Int
  appointmentId   Int?
  appointmentInfo Json?
  paymentStatus   PaymentStatus     @default(UNPAID)
  CoupunOrderUser CoupunOrderUser[]
  appointment     Appointment?      @relation(fields: [appointmentId], references: [id])
  user            User              @relation(fields: [userId], references: [userId])
  items           OrderItem[]
}

model OrderItem {
  orderItemId Int      @id @default(autoincrement())
  quantity    Int
  createdAt   DateTime @default(now())
  orderId     Int
  productId   Int
  order       Order    @relation(fields: [orderId], references: [orderId])
  product     Product  @relation(fields: [productId], references: [productId])
}

model Product {
  productId   Int         @id @default(autoincrement())
  name        String
  price       Float
  description String
  stock       Int
  createdAt   DateTime    @default(now())
  cartItems   CartItem[]
  orderItems  OrderItem[]
}

model Cart {
  cartId    Int        @id @default(autoincrement())
  createdAt DateTime   @default(now())
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [userId])
  items     CartItem[]
}

model CartItem {
  cartItemId Int      @id @default(autoincrement())
  quantity   Int
  createdAt  DateTime @default(now())
  cartId     Int
  productId  Int
  cart       Cart     @relation(fields: [cartId], references: [cartId])
  product    Product  @relation(fields: [productId], references: [productId])
}

model Coupon {
  couponId        Int               @id @default(autoincrement())
  code            String            @unique
  discount        Decimal
  expireAt        DateTime
  createdAt       DateTime          @default(now())
  CoupunOrderUser CoupunOrderUser[]
}

model CoupunOrderUser {
  userId   Int
  orderId  Int
  couponId Int
  coupun   Coupon @relation(fields: [couponId], references: [couponId])
  order    Order  @relation(fields: [orderId], references: [orderId])
  user     User   @relation(fields: [userId], references: [userId])

  @@id([userId, orderId, couponId])
}

model BlacklistedToken {
  id            Int      @id @default(autoincrement())
  token         String   @unique
  userId        Int
  blacklistedAt DateTime @default(now())
  expiresAt     DateTime
}

model Appointment {
  id             Int               @id @default(autoincrement())
  serviceType    String
  name           String
  phone          String
  region         String
  address        String?
  sceneType      String[]
  location       String
  createdAt      DateTime          @default(now())
  userId         Int
  cancelReason   String?
  cancelledAt    DateTime?
  cityCode       String?
  completedAt    DateTime?
  districtCode   String?
  followUpCount  Int               @default(0)
  lastFollowUpAt DateTime?
  latitude       Float?
  longitude      Float?
  description    String?           // 预约描述字段
  imageUrls      String[]          // 图片URL数组
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [userId])
  orders         Order[]
}

enum Status {
  PENDING    // 待接单
  ACCEPTED   // 已接单
  PROCESSING // 施工中
  COMPLETED  // 已完成
  CANCELLED  // 已取消
  DELIVERED  // 已交付 (保留原有状态)
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum AppointmentStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

// 引荐码表
model ReferralCode {
  id            Int             @id @default(autoincrement())
  code          String          @unique  // 引荐码，唯一
  description   String?         // 引荐码描述
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  isActive      Boolean         @default(true) // 是否激活
  referrals     UserReferral[]  // 关联的引荐记录
}

// 向量知识库相关模型
model ChatMessage {
  id            String    @id @default(cuid())
  groupName     String    // 群聊名称
  sender        String    // 发送者
  content       String    // 消息内容
  timestamp     DateTime  // 消息时间戳
  messageHash   String    @unique // 消息内容哈希，用于去重
  embedding     Unsupported("vector(1536)")? // 向量嵌入，使用1536维度（OpenAI标准）
  metadata      Json?     // 额外元数据
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // 关联的向量块
  chunks        MessageChunk[]
  // 关联的摘要
  summaries     ChatSummary[]
  
  @@index([groupName, timestamp])
  @@index([sender, timestamp])
  @@index([messageHash])
  @@map("chat_messages")
}

model MessageChunk {
  id            String    @id @default(cuid())
  messageId     String    // 关联的消息ID
  chunkIndex    Int       // 块索引
  content       String    // 块内容
  embedding     Unsupported("vector(1536)")? // 向量嵌入
  tokenCount    Int       // token数量
  metadata      Json?     // 块元数据
  createdAt     DateTime  @default(now())
  
  message       ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  
  @@unique([messageId, chunkIndex])
  @@map("message_chunks")
}

model ChatSummary {
  id            String    @id @default(cuid())
  groupName     String    // 群聊名称
  summaryType   String    // 摘要类型 (daily, weekly, topic, etc.)
  timeRange     String    // 时间范围
  title         String    // 摘要标题
  content       String    // 摘要内容
  keyPoints     String[]  // 关键点
  participants  String[]  // 参与者
  topics        String[]  // 主题标签
  embedding     Unsupported("vector(1536)")? // 摘要向量嵌入
  messageCount  Int       // 相关消息数量
  startTime     DateTime  // 开始时间
  endTime       DateTime  // 结束时间
  metadata      Json?     // 额外元数据
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // 关联的消息
  messages      ChatMessage[]
  
  @@index([groupName, summaryType, timeRange])
  @@index([startTime, endTime])
  @@map("chat_summaries")
}

model VectorKnowledge {
  id            String    @id @default(cuid())
  namespace     String    // 命名空间 (chat_history, summaries, topics, etc.)
  title         String    // 知识标题
  content       String    // 知识内容
  embedding     Unsupported("vector(1536)")? // 向量嵌入
  tags          String[]  // 标签
  source        String?   // 来源
  sourceId      String?   // 来源ID
  importance    Float     @default(1.0) // 重要性评分
  accessCount   Int       @default(0) // 访问次数
  lastAccessed  DateTime? // 最后访问时间
  metadata      Json?     // 元数据
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([namespace, importance])
  @@index([tags])
  @@index([sourceId])
  @@map("vector_knowledge")
}

model ContextWindow {
  id            String    @id @default(cuid())
  sessionId     String    // 会话ID
  groupName     String    // 群聊名称
  windowType    String    // 窗口类型 (sliding, semantic, hybrid)
  content       String    // 上下文内容
  embedding     Unsupported("vector(1536)")? // 上下文向量
  tokenCount    Int       // token数量
  messageIds    String[]  // 包含的消息ID列表
  startTime     DateTime  // 窗口开始时间
  endTime       DateTime  // 窗口结束时间
  relevanceScore Float    @default(1.0) // 相关性评分
  metadata      Json?     // 元数据
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([sessionId, groupName])
  @@index([windowType, relevanceScore])
  @@map("context_windows")
}

model EmbeddingCache {
  id            String    @id @default(cuid())
  contentHash   String    @unique // 内容哈希
  content       String    // 原始内容
  embedding     Unsupported("vector(1536)") // 向量嵌入
  model         String    @default("text-embedding-3-small") // 嵌入模型
  tokenCount    Int       // token数量
  createdAt     DateTime  @default(now())
  lastUsed      DateTime  @default(now())
  useCount      Int       @default(1)
  
  @@index([contentHash])
  @@index([model])
  @@map("embedding_cache")
}

// 聊天Agent模型
model ChatAgent {
  id            String    @id @default(cuid())
  name          String    // Agent名称
  description   String    // Agent描述
  type          String    // Agent类型 (product, support, referral, etc.)
  systemPrompt  String    @map("system_prompt") // Agent系统提示词
  capabilities  String[]  // Agent能力列表
  modelConfig   Json      @map("model_config") // 模型配置
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  // 关联的聊天会话
  sessions      ChatSession[]
  
  @@index([type, active])
  @@map("chat_agents")
}

// 聊天会话模型
model ChatSession {
  id            String    @id @default(cuid())
  userId        Int       @map("user_id") // 关联用户ID
  agentId       String    @map("agent_id") // 关联Agent ID
  status        String    @default("active") // 会话状态 (active, ended)
  startTime     DateTime  @default(now()) @map("start_time")
  endTime       DateTime? @map("end_time") // 结束时间
  title         String?   // 会话标题
  summary       String?   // 会话摘要
  metadata      Json?     // 元数据
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  // 关联的用户
  user          User      @relation(fields: [userId], references: [userId])
  // 关联的Agent
  agent         ChatAgent @relation(fields: [agentId], references: [id])
  // 关联的消息
  messages      ChatSessionMessage[]
  
  @@index([userId, status])
  @@index([agentId, status])
  @@map("chat_sessions")
}

// 会话消息模型
model ChatSessionMessage {
  id            String    @id @default(cuid())
  sessionId     String    @map("session_id") // 关联会话ID
  role          String    // 消息角色 (user, assistant, system)
  content       String    // 消息内容
  embedding     Unsupported("vector(1536)")? // 向量嵌入
  timestamp     DateTime  @default(now())
  metadata      Json?     // 元数据
  
  // 关联的会话
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  @@index([sessionId, timestamp])
  @@index([role, timestamp])
  @@map("chat_session_messages")
}

// 语义意图模型
model SemanticIntent {
  id            String    @id @default(cuid())
  name          String    // 意图名称
  description   String    // 意图描述
  examples      String[]  // 示例语句
  agentType     String    @map("agent_type") // 对应的Agent类型
  priority      Int       @default(1) // 优先级
  embedding     Unsupported("vector(1536)")? // 向量嵌入
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  @@index([agentType, active])
  @@map("semantic_intents")
}
