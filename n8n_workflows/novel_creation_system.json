    {
      "parameters": {
        "jsCode": "// 作家Agent核心逻辑\nconst worldData = items[0].json;\nconst characterData = items[1].json;\n\n// 生成章节大纲\nfunction generateChapterOutline(chapterNum, characterState) {\n  const worldCategories = [\"动漫类世界\", \"电影类世界\", \"游戏类世界\", \"文学类世界\"];\n  const selectedCategory = worldCategories[Math.floor(Math.random() * worldCategories.length)];\n  \n  const diceRoll = Math.floor(Math.random() * 20) + 1;\n  let worldType, risk, reward;\n  \n  if (diceRoll \u003c= 5) {\n    worldType = \"安全区\"; risk = \"低\"; reward = \"一般\";\n  } else if (diceRoll \u003c= 10) {\n    worldType = \"挑战区\"; risk = \"中\"; reward = \"丰厚\";\n  } else if (diceRoll \u003c= 15) {\n    worldType = \"危险区\"; risk = \"高\"; reward = \"极高\";\n  } else if (diceRoll \u003c= 19) {\n    worldType = \"地狱区\"; risk = \"极高\"; reward = \"SS级\";\n  } else {\n    worldType = \"混沌面\"; risk = \"未知\"; reward = \"隐藏\";\n  }\n  \n  return {\n    chapter_num: chapterNum,\n    world_category: selectedCategory,\n    world_type: worldType,\n    dice_result: {\n      roll: diceRoll,\n      risk: risk,\n      reward: reward\n    },\n    character_arc: {\n      psychological_state: characterState.psychological_state || \"适应中\",\n      power_level: characterState.power_level || \"凡人级\",\n      relationships: characterState.relationships || []\n    },\n    generated_at: new Date().toISOString()\n  };\n}\n\nconst chapterNum = $node.trigger_daily.json.chapter_num || 1;\nconst outline = generateChapterOutline(chapterNum, characterData);\n\nreturn [outline];"
      },
